# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated device-testing hostnames; no URLs, ports or wildcards.
MARGIN_DEV_ALLOWED_HOSTS=

# Clerk (managed authentication, passkey/MFA configurable in Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Optional separate migration role. Never expose this credential to client code.
MIGRATION_DATABASE_URL=

# Cloudflare R2 (use a bucket-scoped API token with only required object permissions)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upstash Redis / rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
# Optional. SDK payloads are filtered; also configure server-side IP scrubbing in Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Private backend slice: keep disabled until migration and hosted-provider gates pass.
# Accounts must be explicitly provisioned ACTIVE; this does not enable registration.
MARGIN_PRIVATE_BACKEND_ENABLED=

# Invitation-code registration. Keep off until operator/policy and provider gates pass.
# Uses single-use hashed Invitation records; never use a client-side shared access code.
MARGIN_REGISTRATION_ENABLED=
