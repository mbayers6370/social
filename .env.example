# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Intended production origin: https://margin.social. Keep localhost for local work.
# General support inbox: support@margin.social (not a Clerk sending credential).
# Optional comma-separated device-testing hostnames; no URLs, ports or wildcards.
MARGIN_DEV_ALLOWED_HOSTS=

# Clerk: matching publishable/secret keys from ONE instance. No secret in NEXT_PUBLIC_.
# Development uses pk_test_/sk_test_; production requires pk_live_/sk_live_ and
# an explicit HTTPS NEXT_PUBLIC_APP_URL origin (no path, query or credentials).
# Provider registration, email verification, recovery and session policy:
# docs/account-flows.md#hosted-activation-checklist
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Optional separate migration role. Never expose this credential to client code.
MIGRATION_DATABASE_URL=

# Cloudflare R2 (use a bucket-scoped API token with only required object permissions)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upstash Redis / distributed rate limiting. Required for managed session checks,
# invitations and onboarding; missing/unavailable Redis deliberately denies access.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
# Optional. SDK payloads are filtered; also configure server-side IP scrubbing in Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Private backend slice: keep disabled until migration and hosted-provider gates pass.
# Completed PENDING accounts require the operator-only account:activate command.
# This does not enable registration. Review the activation checklist first.
MARGIN_PRIVATE_BACKEND_ENABLED=

# Invitation-link registration. Keep off until operator/policy and provider gates pass.
# Uses email-bound Clerk invitations and single-use database claims; never a public signup code.
MARGIN_REGISTRATION_ENABLED=
# Server-only Ticketmaster Discovery API key. Never prefix with NEXT_PUBLIC_.
TICKETMASTER_API_KEY=

# Server-only, stable random secret (at least 32 bytes encoded as base64url). Rotating invalidates invitation links.
INVITATION_LINK_SECRET=

# Explicit private filesystem storage for local development only; prohibited in production.
MARGIN_LOCAL_PHOTO_STORE=
