generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Internal application identity. Authentication is handled by Clerk; never store credentials here.
model User {
  id              String         @id @default(cuid())
  clerkId         String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  topFriends ProfileTopFriend[] @relation("TopFriendOwner")
  featuredBy ProfileTopFriend[] @relation("TopFriendSelection")
  topFriendMutations ProfileTopFriendMutation[]
  songs           ProfileSong[]
  safetyReports   SafetyReport[]
  operatorActions OperatorAction[]
  account         Account?
  posts           Post[]
  postingUsage    PostingUsage[]
  photos          Photo[]
  gallery         GalleryEntry[]
  friendshipsLow  Friendship[]   @relation("FriendLow")
  friendshipsHigh Friendship[]   @relation("FriendHigh")
  spacesCreated   Space[] @relation("SpaceCreator")
  memberships     SpaceMembership[]
  spaceInvitesSent SpaceInvitation[] @relation("SpaceInviter")
  spaceInvitesReceived SpaceInvitation[] @relation("SpaceInvitee")
  comments PostComment[]
  sentMessages MemberMessage[] @relation("MessageSender")
  receivedMessages MemberMessage[] @relation("MessageRecipient")
  activity MemberNotification[] @relation("NotificationRecipient")
  activityBy MemberNotification[] @relation("NotificationActor")
  likes PostLike[]
  blocksSent      Block[]        @relation("BlockSender")
  blocksReceived  Block[]        @relation("BlockRecipient")
}

/// Activation is separate from provider identity and legacy preview music users.
model Account {
  postingTimeZone String @default("America/Los_Angeles") @db.VarChar(100)
  postingUsageCarryFrom DateTime?
  postingUsageCarryUntil DateTime?
  portraitPhotoId String?
  portrait Photo? @relation(fields: [portraitPhotoId], references: [id], onDelete: SetNull)
  usernameChangedAt DateTime?
  galleryVersion Int @default(0)
  readingSize String @default("standard") @db.VarChar(16)
  motion String @default("system") @db.VarChar(16)
  notifyComments Boolean @default(true)
  notifyLikes Boolean @default(false)
  notifyFriends Boolean @default(true)
  notifyMessages Boolean @default(true)
  messagingEnabled Boolean @default(true)
  showTopFriends Boolean @default(true)
  username String? @unique @db.VarChar(24)
  bio String @default("") @db.VarChar(300)
  emailVerifiedAt DateTime?
  displayName String @default("Margin member") @db.VarChar(80)
  /// Legacy lifetime allowance fields, retained for schema compatibility only.
  /// Available slots are derived from active personal InvitationLinks.
  invitationsRemaining Int @default(0)
  invitationAllowanceGrantedAt DateTime?
  role AccountRole @default(MEMBER)
  onboardedAt DateTime?
  ageConfirmedAt DateTime?
  userId String        @id
  status AccountStatus @default(PENDING)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountStatus {
  PENDING
  ACTIVE
  DEACTIVATED
}

enum AccountRole {
  MEMBER
  FOUNDER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum PhotoState {
  PENDING
  READY
  DELETE_PENDING
  PURGED
}

model Friendship {
  lowId       String
  highId      String
  requesterId String
  status      FriendshipStatus @default(PENDING)
  low         User             @relation("FriendLow", fields: [lowId], references: [id], onDelete: Cascade)
  high        User             @relation("FriendHigh", fields: [highId], references: [id], onDelete: Cascade)

  @@id([lowId, highId])
  @@index([highId, status])
}

model Block {
  blockerId String
  blockedId String
  blocker   User   @relation("BlockSender", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("BlockRecipient", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Post {
  activity MemberNotification[]
  likes PostLike[]
  spaceId String?
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  comments PostComment[]
  id        String      @id @default(cuid())
  ownerId   String
  body      String
  hasLink   Boolean
  dayKey    String
  createdAt DateTime    @default(now())
  expiresAt DateTime
  deletedAt DateTime?
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos    PostPhoto[]

  @@unique([id, ownerId])
  @@index([ownerId, dayKey])
  @@index([spaceId, createdAt, id])
  @@index([expiresAt])
}

/// Canonical, normalized private object. Object keys are never returned in DTOs.
model Photo {
  portraits Account[]
  id              String        @id @default(cuid())
  ownerId         String
  objectKey       String        @unique
  state           PhotoState    @default(PENDING)
  dayKey          String
  createdAt       DateTime      @default(now())
  uploadExpiresAt DateTime
  description     String
  width           Int
  height          Int
  byteLength      Int
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts           PostPhoto[]
  gallery         GalleryEntry?
  uploadedAt DateTime?
  purgeAttemptedAt DateTime?
  spaceReferences SpacePhoto[]

  @@unique([id, ownerId])
  @@index([ownerId, dayKey, state])
  @@index([state, uploadExpiresAt])
}

/// Minimal publication ledger survives post deletion. No post body or media data.
model PostingUsage {
  id String @id @default(cuid())
  postId String @unique
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime
  hasLink Boolean
  timeZone String @db.VarChar(100)
  @@index([ownerId, createdAt])
  @@index([createdAt, id])
}

model PostPhoto {
  postId  String
  photoId String
  ownerId String
  post    Post   @relation(fields: [postId, ownerId], references: [id, ownerId], onDelete: Cascade)
  photo   Photo  @relation(fields: [photoId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([postId, photoId])
  @@index([photoId])
}

model GalleryEntry {
  position Int @default(0)
  featured Boolean @default(false)
  photoId String @id
  ownerId String
  photo   Photo  @relation(fields: [photoId, ownerId], references: [id, ownerId], onDelete: Cascade)
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([photoId, ownerId])
  @@index([ownerId])
  @@index([ownerId, position])
}

/// Durable participant-only messages; self-addressed messages form the Notebook.
model MemberMessage {
  id String @id @default(cuid())
  senderId String
  recipientId String
  requestId String @db.VarChar(80)
  body String @db.VarChar(2000)
  createdAt DateTime @default(now())
  readAt DateTime?
  hiddenBySender Boolean @default(false)
  hiddenByRecipient Boolean @default(false)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([senderId, requestId])
  @@index([senderId, recipientId, createdAt, id])
  @@index([recipientId, readAt, createdAt])
  @@index([createdAt, id])
}

/// Aggregate health and private scan progress; never serialized as a raw row.
model MaintenanceJob {
  name String @id
  leaseOwner String?
  leaseUntil DateTime?
  lastStartedAt DateTime?
  lastSucceededAt DateTime?
  lastFailedAt DateTime?
  failures Int @default(0)
  result Json?
  objectCursor String?
}

model MemberNotification {
  id String @id @default(cuid())
  recipientId String
  actorId String
  kind String @db.VarChar(24)
  postId String?
  dedupeKey String @unique @db.VarChar(200)
  createdAt DateTime @default(now())
  readAt DateTime?
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt, id])
}

model PostLike {
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

/// Three ordered references to catalogue songs. No audio, tokens or artwork bytes.
model ProfileSong {
  userId          String
  position        Int
  providerTrackId String
  title           String
  artist          String
  artworkUrl      String?
  appleUrl        String
  spotifyUrl      String
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, position])
  @@unique([userId, providerTrackId])
}

/// A single-use bearer invitation. Only a SHA-256 digest is stored.
model Invitation {
  createdBy String?
  id String @id @default(cuid())
  digest String @unique
  email String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  claimedBy String?
  claimedAt DateTime?
  revokedAt DateTime?
  clerkInvitationId String? @unique
  providerRevokedAt DateTime?
  deliveryAttemptedAt DateTime?
  providerCheckedAt DateTime?
  founderSubject String?
  linkId String?
  link InvitationLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)
  @@index([linkId, email])
  @@index([revokedAt, providerRevokedAt])
  @@index([founderSubject])
}

/// Members may hold three active personal links; completed claims, expiry and revocation free slots.
model InvitationLink {
  id String @id @default(cuid())
  digest String @unique
  createdBy String
  community Boolean @default(false)
  label String? @db.VarChar(80)
  maxRedemptions Int @default(1)
  acceptedCount Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  requestId String
  invitations Invitation[]
  @@unique([createdBy, requestId])
  @@index([createdBy, createdAt])
  @@index([expiresAt])
}

/// Minimal report records; content access is checked before accepting the target.
model SafetyReport {
  id String @id @default(cuid())
  reporterId String
  targetKind String
  targetId String
  targetPersonId String
  reason String
  details String
  status String @default("RECEIVED")
  createdAt DateTime @default(now())
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  review OperatorAction?
  @@index([reporterId, createdAt])
  @@index([status, createdAt, id])
}

/// Purpose-limited operator audit. No message bodies, photographs or credentials.
model OperatorAction {
  id String @id @default(cuid())
  operatorId String
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  reportId String? @unique
  report SafetyReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  action String @db.VarChar(32)
  targetId String
  note String @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@index([operatorId, createdAt])
}


enum SpaceKind {
  PRIVATE
  GATHERING
  EVENT
}
enum SpaceRole {
  ADMIN
  MEMBER
}
enum SpaceRsvp {
  GOING
  MAYBE
  DECLINED
}
model Space {
  id String @id @default(cuid())
  name String @db.VarChar(100)
  kind SpaceKind
  creatorId String
  creator User @relation("SpaceCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  startsAt DateTime?
  timeZone String?
  location String? @db.VarChar(300)
  rsvpEnabled Boolean @default(true)
  ticketmasterId String? @unique
  endsAt DateTime?
  expiresAt DateTime?
  imageUrl String?
  sourceUrl String?
  archivedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  memberships SpaceMembership[]
  invitations SpaceInvitation[]
  posts Post[]
  photos SpacePhoto[]
  @@index([kind, archivedAt, id])
  @@index([expiresAt])
}
model SpaceMembership {
  spaceId String
  userId String
  role SpaceRole @default(MEMBER)
  includeInFeed Boolean @default(false)
  rsvp SpaceRsvp?
  joinedAt DateTime @default(now())
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([spaceId, userId])
  @@index([userId, spaceId])
}
model SpaceInvitation {
  id String @id @default(cuid())
  spaceId String
  inviterId String
  inviteeId String
  expiresAt DateTime
  acceptedAt DateTime?
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  inviter User @relation("SpaceInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("SpaceInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  @@index([inviteeId, expiresAt])
}
/// Includes in-flight reservations; one asset occupies one slot in each referencing Space.
model SpacePhoto {
  spaceId String
  photoId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  @@id([spaceId, photoId])
  @@index([photoId])
}
model PostComment {
  replyToId String?
  id String @id @default(cuid())
  postId String
  authorId String
  body String @db.VarChar(2000)
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([id, postId])
  @@index([postId, createdAt, id])
}

/// Ordered profile detail; never a public friend list.
model ProfileTopFriend {
  ownerId String
  friendId String
  position Int
  createdAt DateTime @default(now())
  owner User @relation("TopFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("TopFriendSelection", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([ownerId, friendId])
  @@unique([ownerId, position])
  @@index([friendId])
}

/// Retry receipts prevent an old request from overwriting a newer selection.
model ProfileTopFriendMutation {
  ownerId String
  requestId String @db.Uuid
  payloadHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, requestId])
}
