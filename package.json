{
  "name": "social-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/application.mjs dev",
    "build": "node scripts/application.mjs build",
    "start": "node scripts/application.mjs start",
    "review": "node --experimental-strip-types scripts/local-review.mjs",
    "review:build": "node --experimental-strip-types scripts/local-review.mjs --build-only",
    "clean:local": "node scripts/clean-local-artifacts.mjs",
    "local:check": "node scripts/check-local-storage.mjs",
    "lint": "eslint .",
    "styles:check": "node scripts/check-styles.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format:check": "prettier --check .",
    "postinstall": "npm run db:generate",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file-if-exists=.env node_modules/prisma/build/index.js studio",
    "db:local": "node scripts/local-db.mjs setup",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "test:db": "RUN_LOCAL_DB_TESTS=1 node --env-file=.env node_modules/vitest/vitest.mjs run tests/music-db.integration.test.ts",
    "test:music:live": "RUN_LOCAL_DB_TESTS=1 RUN_LIVE_MUSIC_TEST=1 node --env-file=.env node_modules/vitest/vitest.mjs run tests/music-db.integration.test.ts",
    "check": "node scripts/verify.mjs --quick",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "test:social-db": "node scripts/test-social-db.mjs",
    "account:activate": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/activate-account.mjs",
    "test:auth-db": "node scripts/test-social-db.mjs --auth",
    "test:auth-redis:live": "RUN_LIVE_AUTH_TESTS=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/auth-redis-live.integration.test.ts",
    "test:auth:live": "RUN_LIVE_AUTH_TESTS=1 node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/test-auth-live.mjs",
    "account:invite": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/create-invitation.mjs",
    "account:founder": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/grant-founder.mjs",
    "invitations:sync": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/sync-invitations.mjs",
    "maintenance:run": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-transform-types --env-file-if-exists=.env scripts/maintenance.mjs run",
    "maintenance:work": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-transform-types --env-file-if-exists=.env scripts/maintenance.mjs work",
    "maintenance:status": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-transform-types --env-file-if-exists=.env scripts/maintenance.mjs status",
    "account:bootstrap-founder": "node --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types --env-file-if-exists=.env scripts/bootstrap-founder.mjs",
    "test:invitations:live": "RUN_LIVE_INVITATION_TESTS=1 node --env-file-if-exists=.env --import ./scripts/register-typescript.mjs --conditions=react-server --experimental-strip-types scripts/test-invitations-live.mjs",
    "verify:extended": "node scripts/verify.mjs --extended",
    "test:inventory": "node scripts/testing/inventory.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@clerk/nextjs": "^7.9.20",
    "@clerk/ui": "1.42.0",
    "@hookform/resolvers": "^5.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^11.9.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.5.0",
    "tldts": "6.1.86",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
