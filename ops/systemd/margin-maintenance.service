[Unit]
Description=Margin retention and invitation reconciliation worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=margin
WorkingDirectory=/srv/margin
Environment=NODE_ENV=production
EnvironmentFile=/etc/margin/maintenance.env
ExecStart=/usr/bin/npm run maintenance:work
Restart=always
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
